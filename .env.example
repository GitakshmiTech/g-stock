# Application Environment
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nse_market_data
MYSQL_USER=nse_app
MYSQL_PASSWORD=replace_with_secret
DB_DIALECT=mysql

# SQLite fallback (optional for isolated unit testing or development)
SQLITE_DB_PATH=./data/nse_market_data.db
USE_SQLITE_FALLBACK=true

# MongoDB Configuration (Compass & Analytics Storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nse_market_data
ENABLE_MONGODB=true

# Historical Backfill Defaults
DATA_START_DATE=2001-01-01
DATA_END_DATE=2026-10-09
BACKFILL_BATCH_DAYS=30

# File Storage Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
QUARANTINE_DIR=./data/quarantine
EXPORTS_DIR=./data/exports

# Daily EOD Ingestion Settings
DAILY_UPDATE_TIME=16:00
DAILY_RETRY_MAX_WAIT_MINUTES=60
DAILY_RETRY_INITIAL_SECONDS=60
DAILY_RETRY_MAX_SECONDS=600
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_RETRIES=5

# Notification Alerts (Optional)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=admin@example.com
